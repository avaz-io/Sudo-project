# Copy this file to .env in the repository root. Never commit .env.
# Generate SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# One local port for frontend pages, /api, and API documentation.
WEB_PORT=8000
# Use ./frontend/dist after the frontend owner provides a production build.
# The directory must already exist and contain a readable index.html and assets.
FRONTEND_DIST_DIR=./devops/site
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=[]
UNIVERSITY_TIMEZONE=Asia/Tashkent

# Optional: add your ngrok authtoken when you are ready to share the website.
NGROK_AUTHTOKEN=
