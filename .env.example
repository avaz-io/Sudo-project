# Copy this file to .env in the repository root. Never commit .env.
# Generate SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

BACKEND_PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=[]
UNIVERSITY_TIMEZONE=Asia/Tashkent

# Optional: add your ngrok authtoken when you are ready to share the backend.
NGROK_AUTHTOKEN=
