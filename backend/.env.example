# Copy to backend/.env and fill in real values. Never commit .env.

# SQLite file for local development. For PostgreSQL use e.g.
# postgresql+psycopg://user:password@localhost:5432/event_manager
DATABASE_URL=sqlite:///./event_manager.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# JSON list of allowed frontend origins (Vite dev server by default).
CORS_ORIGINS=["http://localhost:5173"]

# IANA timezone used for displaying/validating event times. Datetimes are stored in UTC.
UNIVERSITY_TIMEZONE=Asia/Tashkent

# Fill an empty database with demo users and events on startup (local development only).
# Demo accounts such as organizer@newuu.uz and student@newuu.uz use the password "password123".
SEED_DEMO_DATA=true
