# Only application source, tests, and image configuration enter the build context.
**
!Dockerfile
!backend/
!backend/app/
!backend/app/**
!backend/requirements.txt
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/eslint.config.js
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!tests/
!tests/**
!pytest.ini
!devops/
!devops/constraints.txt
!devops/Dockerfile.web
!devops/nginx.conf

**/__pycache__/
**/node_modules/
**/dist/
**/.pytest_cache/
**/*.py[cod]
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite*
**/*.pem
**/*.key
