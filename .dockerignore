# Only application source, tests, and image configuration enter the build context.
**
!Dockerfile
!backend/
!backend/app/
!backend/app/**
!backend/requirements.txt
!tests/
!tests/**
!pytest.ini
!devops/
!devops/constraints.txt
!devops/Dockerfile.web
!devops/nginx.conf

**/__pycache__/
**/.pytest_cache/
**/*.py[cod]
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite*
**/*.pem
**/*.key
